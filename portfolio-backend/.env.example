# =============================================
# Variables d'environnement — NE PAS COMMITER
# Copie ce fichier en .env et remplis les valeurs
# =============================================

# PostgreSQL
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=portfolio

# Mail via Resend
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=Portfolio <onboarding@resend.dev>
MAIL_SEND_CONFIRMATION=false

# CORS (front local + front de prod)
CORS_ORIGINS=https://gauthierdebra.vercel.app,https://*.vercel.app,http://localhost:5173

# Destinataire des notifications portfolio
MAIL_TO=gauthier.debra@outlook.fr

# Credentials des routes admin
ADMIN_USERNAME=portfolio-admin
ADMIN_PASSWORD=remplace-par-un-mot-de-passe-solide
